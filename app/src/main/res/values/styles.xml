<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Text -->
    <style name="TextScreenTitle">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/onSurface</item>
    </style>

    <style name="TextHeading">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/onSurface</item>
    </style>

    <style name="TextTitle">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/onSurface</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/onSurface</item>
    </style>

    <style name="TextSecondary">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/secondaryText</item>
    </style>

    <style name="TextSmall">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/secondaryText</item>
    </style>

    <style name="TextSheetSection">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/onSurface</item>
    </style>

    <!-- Cards -->
    <style name="AppCard">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/stroke_card</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="cardBackgroundColor">@color/surface_elevated</item>
    </style>

    <style name="AppCardSoft">
        <item name="cardCornerRadius">@dimen/card_radius_sm</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="cardBackgroundColor">@color/surfaceVariant</item>
    </style>

    <!-- Chips / badges -->
    <style name="ChipBase">
        <item name="android:paddingStart">@dimen/chip_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/chip_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/chip_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/chip_padding_vertical</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="BadgeText">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Buttons -->
    <style name="ButtonPrimary">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
    </style>

    <style name="ButtonGhost">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/divider</item>
    </style>

    <style name="AppFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">14dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipBackgroundColor">@color/chip_filter_bg_selector</item>
        <item name="android:textColor">@color/chip_filter_text_selector</item>
        <item name="chipStrokeColor">@color/stroke_soft</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="AppFilterChip.Checked" parent="AppFilterChip">
        <item name="chipBackgroundColor">@color/primary_container</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="AppPanelCard">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surfaceSoft</item>
    </style>

</resources>