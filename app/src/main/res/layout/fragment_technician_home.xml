<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_screen_horizontal"
        android:paddingTop="@dimen/padding_section"
        android:paddingEnd="@dimen/padding_screen_horizontal"
        android:paddingBottom="@dimen/padding_section">

        <TextView
            android:id="@+id/tvWelcome"
            style="@style/TextScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido, técnico" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/TextSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:lineSpacingExtra="2dp"
            android:text="Consulta tus incidencias asignadas, la cola del equipo y las notificaciones" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMyAssigned"
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_elevated"
            app:rippleColor="@color/card_ripple"
            app:strokeColor="@color/stroke_card"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_lg">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_incidents"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mis incidencias asignadas" />

                    <TextView
                        style="@style/TextSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Accede a las incidencias que tienes actualmente en seguimiento" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMyAssignedCount"
                    style="@style/BadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_counter"
                    android:minWidth="@dimen/badge_size"
                    android:paddingStart="@dimen/chip_padding_horizontal"
                    android:paddingTop="@dimen/chip_padding_vertical"
                    android:paddingEnd="@dimen/chip_padding_horizontal"
                    android:paddingBottom="@dimen/chip_padding_vertical"
                    android:text="0"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTeamQueue"
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_elevated"
            app:rippleColor="@color/card_ripple"
            app:strokeColor="@color/stroke_card"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_lg">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_history"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendientes del equipo" />

                    <TextView
                        style="@style/TextSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Consulta incidencias del equipo que todavía no tienen técnico asignado" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTeamQueueCount"
                    style="@style/BadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_counter"
                    android:minWidth="@dimen/badge_size"
                    android:paddingStart="@dimen/chip_padding_horizontal"
                    android:paddingTop="@dimen/chip_padding_vertical"
                    android:paddingEnd="@dimen/chip_padding_horizontal"
                    android:paddingBottom="@dimen/chip_padding_vertical"
                    android:text="0"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotifications"
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_elevated"
            app:rippleColor="@color/card_ripple"
            app:strokeColor="@color/stroke_card"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_lg">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_notifications"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notificaciones" />

                    <TextView
                        style="@style/TextSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Revisa asignaciones, cambios de estado, mensajes y adjuntos recientes" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNotificationsCount"
                    style="@style/BadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_counter"
                    android:minWidth="@dimen/badge_size"
                    android:paddingStart="@dimen/chip_padding_horizontal"
                    android:paddingTop="@dimen/chip_padding_vertical"
                    android:paddingEnd="@dimen/chip_padding_horizontal"
                    android:paddingBottom="@dimen/chip_padding_vertical"
                    android:text="0"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>