<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_screen_horizontal"
    android:paddingTop="@dimen/spacing_md"
    android:paddingEnd="@dimen/padding_screen_horizontal"
    android:paddingBottom="@dimen/spacing_xl">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Cabecera -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filtrar incidencias"
        android:textColor="@color/onSurface"
        android:textSize="@dimen/text_sheet_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="Ajusta estado y prioridad para ver solo lo que te interesa."
        android:textColor="@color/secondaryText"
        android:textSize="@dimen/text_small" />

    <!-- Estado -->
    <TextView
        android:id="@+id/tvStatusLabel"
        style="@style/TextSheetSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="Estado" />

    <RadioGroup
        android:id="@+id/rgStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm">

        <RadioButton
            android:id="@+id/rbStatusAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:minHeight="44dp"
            android:text="Todas"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/rbStatusOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:minHeight="44dp"
            android:text="Abiertas"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/rbStatusInProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:minHeight="44dp"
            android:text="En curso"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/rbStatusResolved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:minHeight="44dp"
            android:text="Resueltas"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/text_body" />
    </RadioGroup>

    <!-- Prioridad -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="Prioridad"
        android:textColor="@color/onSurface"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgPriority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm">

        <RadioButton
            android:id="@+id/rbPriorityAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:minHeight="44dp"
            android:text="Todas"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/rbPriorityLow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:minHeight="44dp"
            android:text="Baja"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/rbPriorityMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:minHeight="44dp"
            android:text="Media"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/rbPriorityHigh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:minHeight="44dp"
            android:text="Alta"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/rbPriorityCritical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:minHeight="44dp"
            android:text="Crítica"
            android:textColor="@color/onSurface"
            android:textSize="@dimen/text_body" />
    </RadioGroup>

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearFilters"
            style="@style/ButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Limpiar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilters"
            style="@style/ButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="Aplicar" />

    </LinearLayout>

</LinearLayout>