<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_screen_horizontal"
        android:paddingTop="@dimen/padding_section"
        android:paddingEnd="@dimen/padding_screen_horizontal"
        android:paddingBottom="@dimen/padding_section">

        <TextView
            android:id="@+id/tvWelcome"
            style="@style/TextScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido, manager" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/TextSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:lineSpacingExtra="2dp"
            android:text="Gestiona incidencias, equipo y notificaciones" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTeamIncidents"
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/card_press_state_animator"
            app:rippleColor="@color/card_ripple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_lg">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_incidents"
                    android:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Incidencias del equipo" />

                    <TextView
                        style="@style/TextSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Consulta, filtra y revisa las incidencias del equipo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTeamIncidentsCount"
                    style="@style/BadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_counter"
                    android:minWidth="@dimen/badge_size"
                    android:paddingStart="@dimen/chip_padding_horizontal"
                    android:paddingTop="@dimen/chip_padding_vertical"
                    android:paddingEnd="@dimen/chip_padding_horizontal"
                    android:paddingBottom="@dimen/chip_padding_vertical"
                    android:text="0"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAssignmentBoard"
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/card_press_state_animator"
            app:rippleColor="@color/card_ripple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_lg">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_assignment"
                    android:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asignación rápida" />

                    <TextView
                        style="@style/TextSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Asigna incidencias pendientes a técnicos disponibles" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUnassignedCount"
                    style="@style/BadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_counter"
                    android:minWidth="@dimen/badge_size"
                    android:paddingStart="@dimen/chip_padding_horizontal"
                    android:paddingTop="@dimen/chip_padding_vertical"
                    android:paddingEnd="@dimen/chip_padding_horizontal"
                    android:paddingBottom="@dimen/chip_padding_vertical"
                    android:text="0"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTeamMembers"
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/card_press_state_animator"
            app:rippleColor="@color/card_ripple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_lg">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_team"
                    android:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mi equipo" />

                    <TextView
                        style="@style/TextSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Consulta técnicos, managers y datos del equipo actual" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPendingClosure"
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/card_press_state_animator"
            app:rippleColor="@color/card_ripple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_lg">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_history"
                    android:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendientes de cierre" />

                    <TextView
                        style="@style/TextSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Revisa incidencias resueltas que siguen pendientes de cierre" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPendingClosureCount"
                    style="@style/BadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_counter"
                    android:minWidth="@dimen/badge_size"
                    android:paddingStart="@dimen/chip_padding_horizontal"
                    android:paddingTop="@dimen/chip_padding_vertical"
                    android:paddingEnd="@dimen/chip_padding_horizontal"
                    android:paddingBottom="@dimen/chip_padding_vertical"
                    android:text="0"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotifications"
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/card_press_state_animator"
            app:rippleColor="@color/card_ripple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_lg">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_notifications"
                    android:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notificaciones" />

                    <TextView
                        style="@style/TextSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Consulta incidencias creadas, mensajes y cambios recientes" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNotificationsCount"
                    style="@style/BadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_counter"
                    android:minWidth="@dimen/badge_size"
                    android:paddingStart="@dimen/chip_padding_horizontal"
                    android:paddingTop="@dimen/chip_padding_vertical"
                    android:paddingEnd="@dimen/chip_padding_horizontal"
                    android:paddingBottom="@dimen/chip_padding_vertical"
                    android:text="0"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>