<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutEmpty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xxl"
    android:visibility="gone">

    <ImageView
        android:id="@+id/ivEmpty"
        android:layout_width="@dimen/icon_size_xl"
        android:layout_height="@dimen/icon_size_xl"
        android:contentDescription="@null"
        android:src="@drawable/ic_home_incidents"
        app:tint="@color/secondaryText" />

    <TextView
        android:id="@+id/tvEmpty"
        style="@style/TextTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:text="No hay datos" />

    <TextView
        android:id="@+id/tvEmptySubtitle"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:text="Prueba más tarde"
        android:visibility="gone" />

</LinearLayout>